@startuml component_overview
title EV充電システム - コンポーネント図

' 外部アクター
actor "ドライバー" as Driver
rectangle "EV本体\n（車載システム）" as EV

' 外部システム
rectangle "EVナビ\nフロントエンド" as NaviApp #lightblue
rectangle "EVナビ\nバックエンド" as NaviBackend #lightblue
rectangle "FLASH" as FLASH #lightyellow
rectangle "SWAPay" as SWAPay #lightyellow

' 自社開発
rectangle "OCPPサーバー" as OCPP #lightgreen {
    component "Java\n（OCPPプロトコル処理）" as JavaPart
    component "Flask\n（外部API連携）" as FlaskPart
    JavaPart --> FlaskPart
}

' 凡例
legend right
  |= 色 |= 区分 |
  |<#lightgreen> 緑 | 自社開発 |
  |<#lightblue> 青 | 外部システム（EVナビ） |
  |<#lightyellow> 黄 | 外部システム（決済） |
endlegend

' 関係
Driver --> NaviApp : 操作
EV --> JavaPart : OCPP通信
NaviBackend --> JavaPart : 認証・制御リクエスト
FlaskPart --> FLASH : API連携
FLASH --> SWAPay : 決済処理
NaviApp --> NaviBackend : API通信

@enduml
